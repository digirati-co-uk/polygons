{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local", "README.md", "scripts/sync-readme.mjs"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "npm/index.*", "npm/README.md"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
