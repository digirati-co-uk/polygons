{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0 --no-open",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:iiif": "IIIF_LIVE=1 playwright test iiif.spec.ts --project=desktop"
  },
  "dependencies": {
    "@atlas-viewer/atlas": "3.3.0",
    "@iiif/helpers": "4.0.0",
    "polygons-core": "workspace:*",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-reconciler": "0.33.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/browser-playwright": "4.0.18",
    "playwright": "1.58.2",
    "storybook": "10.6.5",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}
