{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "pnpm --filter polygons-core test && pnpm --filter web test",
    "storybook": "pnpm --filter web storybook",
    "build-storybook": "pnpm --filter web build-storybook",
    "typecheck": "pnpm --filter web typecheck",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:iiif": "pnpm --filter web test:iiif",
    "docs:sync": "node scripts/sync-readme.mjs",
    "docs:check": "node scripts/sync-readme.mjs --check",
    "test:release": "node --test scripts/release.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.5",
    "eslint": "^8.53.0",
    "prettier": "^3.0.3",
    "tsconfig": "workspace:*",
    "turbo": "latest"
  },
  "packageManager": "pnpm@9.15.9",
  "name": "polygon-helpers",
  "engines": {
    "node": ">=22.12.0"
  }
}
